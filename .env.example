APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: set FILESYSTEM_DISK=s3 and fill AWS_* below for paid files/CDN.
# Paid digital files must be stored on the private disk in production.
ALLOW_LEGACY_PUBLIC_DOWNLOADS=false
QUEUE_CONNECTION=database
# Production: QUEUE_CONNECTION=redis and run `php artisan queue:work redis`
COMMERCE_RESERVATION_MINUTES=30

CACHE_STORE=database
# Production: CACHE_STORE=redis (and optionally SESSION_DRIVER=redis)
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Enable only after reviewing allowed origins on staging.
SECURITY_CSP_ENABLED=false
SECURITY_CSP_REPORT_ONLY=false

# Set before npm run build to enable authenticated Web Push subscriptions.
VITE_VAPID_PUBLIC_KEY=
VITE_APP_NAME="${APP_NAME}"
